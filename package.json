{
  "name": "silly-travel-tool",
  "private": true,
  "version": "0.20.0",
  "versionCode": 6,
  "type": "module",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "dev": "vite",
    "help": "node scripts/build-help.mjs",
    "prebuild": "node scripts/build-help.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives",
    "test": "for f in scripts/test-*.mjs; do echo \"== $f\"; node \"$f\" || exit 1; done; npm run --silent test:migrations",
    "build:native": "vite build --mode native --outDir dist-native && npx cap sync android",
    "android": "npm run build:native && npx cap run android",
    "android:open": "npm run build:native && npx cap open android",
    "check:clay": "node scripts/check-clay.mjs",
    "postbuild": "node scripts/check-dist.mjs && node scripts/check-url-paths.mjs",
    "build:ios": "vite build --mode native --outDir dist-native && npx cap sync ios",
    "test:migrations": "node scripts/test-migrations/invite-privacy-cleanup.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@revenuecat/purchases-capacitor": "13.7.3",
    "@revenuecat/purchases-capacitor-ui": "13.7.3",
    "@sentry/capacitor": "4.4.0",
    "@sentry/react": "10.69.0",
    "@supabase/supabase-js": "^2.39.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@electric-sql/pglite": "0.2.17",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "vite": "^5.0.8",
    "vite-plugin-pwa": "^0.17.4"
  }
}
