# Silly Travel Tool — Hostinger .htaccess
# SPA routing: all routes → index.html (except real files/dirs)

Options -MultiViews
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# www → apex (301). Runs after the HTTPS rule above, so http://www goes https://www → apex in two hops at most.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

# Invite emails link to /invite?token=... (supabase/functions/send-invite). There is no /invite folder; the app reads
# ?token on "/" and rewrites the URL. Serve the app shell for this one path only (the query string passes through).
RewriteRule ^invite/?$ /index.html [L]

# The app only lives at "/" (no client-side routes), and every other page is a real directory with its own
# index.html. So there is no catch-all rewrite: an unknown path is a real 404 (status 404, not the app shell).
ErrorDocument 404 /404.html

# Security headers
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=(self), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  # CSP — every external host the client talks to. Keep in sync when adding APIs.
  # Google Fonts is also in connect-src because the service worker fetches fonts itself (Workbox CacheFirst).
  #   Supabase (REST/auth/functions + realtime wss), Google Fonts, GA4, Sentry ingest,
  #   Open-Meteo (forecast + archive), Nominatim, Photon, BigDataCloud, open.er-api.com, timeapi.io
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://swywrvbuswylvqlktsym.supabase.co https://*.googleusercontent.com https://*.google-analytics.com https://*.googletagmanager.com https://flagcdn.com; connect-src 'self' https://swywrvbuswylvqlktsym.supabase.co wss://swywrvbuswylvqlktsym.supabase.co https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://api.open-meteo.com https://archive-api.open-meteo.com https://nominatim.openstreetmap.org https://photon.komoot.io https://api.bigdatacloud.net https://open.er-api.com https://timeapi.io https://fonts.googleapis.com https://fonts.gstatic.com; worker-src 'self'; manifest-src 'self'; media-src 'self' data: blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"

  # Cache static assets aggressively (Vite hashes filenames)
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Never cache HTML
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Cache manifest/sw for short time
  <FilesMatch "(manifest\.webmanifest|sw\.js)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

# Deny access to sensitive files
<FilesMatch "(\.env|\.htpasswd|\.git)">
  Require all denied
</FilesMatch>
